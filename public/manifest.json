{
  "name": "TabClipper",
  "description": "Copy selected tab title and url to clipboard",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "128": "icons/icon-128x128.png"
  },
  "default_locale": "en",
  "permissions": ["contextMenus", "tabs", "clipboardWrite", "offscreen", "notifications"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
