{
  "name": "chrome-extension-template",
  "private": true,
  "version": "0.0.0",
  "author": "Internet Initiative Japan Inc.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --mode=development --minify=false --sourcemap",
    "watch": "pnpm run dev --watch",
    "test": "pnpm vitest run",
    "coverage": "pnpm vitest run --coverage",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "chrome-types": "^0.1.450",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
